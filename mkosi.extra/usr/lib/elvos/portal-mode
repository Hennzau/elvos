#!/bin/bash
set -eu -o pipefail

dropin=/run/systemd/resolved.conf.d/90-elvos-portal.conf

usage() {
        echo "usage: ${0##*/} up <link> [resolver] | down <link>" >&2
        exit 2
}

action=${1-}
link=${2-}

[[ -n $action && -n $link ]] || usage

case $action in
up)
        resolver=${3-}

        networkctl down wg0 || true

        mkdir -p "${dropin%/*}"
        cat >"$dropin" <<-'EOF'
	[Resolve]
	DNS=
	Domains=
	DNSOverTLS=no
	DNSSEC=no
	EOF
        systemctl reload systemd-resolved

        resolvectl dnsovertls "$link" no
        resolvectl dnssec "$link" no

        if [[ -n $resolver ]]; then
                resolvectl dns "$link" $resolver
        fi

        resolvectl domain "$link" '~.'
        resolvectl default-route "$link" yes
        resolvectl flush-caches
        ;;
down)
        rm -f "$dropin"
        systemctl reload systemd-resolved

        resolvectl revert "$link"
        resolvectl flush-caches

        networkctl up wg0 || true
        ;;
*)
        usage
        ;;
esac
