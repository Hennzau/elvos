{
    "theme": "elvOS Dawn",
    "cli_default_open_behavior": "existing_window",
    "disable_ai": true,
    "base_keymap": "None",
    "autosave": "on_focus_change",
    "format_on_save": "on",
    "terminal": {
        "shell": { "program": "/bin/nu" },
    },
    "project_panel": {
        "dock": "left",
    },
    "auto_install_extensions": {
        "toml": true,
        "html": true,
        "nu": true,
        "git-firefly": true,
    },

    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },

    "tab_size": 4,
    "preferred_line_length": 100,
    "show_whitespaces": "selection",
    "indent_guides": {
        "enabled": true,
    },

    "scrollbar": {
        "show": "auto",
    },

    "buffer_font_family": ".ZedMono",
    "buffer_font_size": 15,
    "ui_font_family": ".ZedSans",
    "ui_font_size": 15,
}
