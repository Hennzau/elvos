[Match]
Name=wg0

[Link]
ActivationPolicy=@ACTIVATION@

[Network]
@ADDRESSES@

[RoutingPolicyRule]
To=10.0.0.0/8
Table=main
Priority=32763

[RoutingPolicyRule]
To=172.16.0.0/12
Table=main
Priority=32763

[RoutingPolicyRule]
To=192.168.0.0/16
Table=main
Priority=32763

[RoutingPolicyRule]
Table=main
SuppressPrefixLength=0
Priority=32764
Family=both

[RoutingPolicyRule]
FirewallMark=0xca6c
InvertRule=yes
Table=51820
Priority=32765
Family=both
